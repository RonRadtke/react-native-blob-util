{
  "description": "The arguments each native layer passes to the callback of the native exists method. utils/existsResult.js normalises them; the JS tests check it reads every shape here, and the native unit tests check each layer still passes its own.",
  "cases": [
    {
      "platform": "android",
      "source": "ReactNativeBlobUtilFS.java: callback.invoke(exists, isDirectory)",
      "args": [true, false],
      "expected": {"exists": true, "isDirectory": false}
    },
    {
      "platform": "android",
      "args": [true, true],
      "expected": {"exists": true, "isDirectory": true}
    },
    {
      "platform": "android",
      "args": [false, false],
      "expected": {"exists": false, "isDirectory": false}
    },
    {
      "platform": "ios",
      "source": "ReactNativeBlobUtilFS.mm: callback(@[@(exists), @(isDir)]) - two arguments",
      "args": [true, false],
      "expected": {"exists": true, "isDirectory": false}
    },
    {
      "platform": "ios",
      "args": [true, true],
      "expected": {"exists": true, "isDirectory": true}
    },
    {
      "platform": "ios",
      "args": [false, false],
      "expected": {"exists": false, "isDirectory": false}
    },
    {
      "platform": "windows",
      "source": "ReactNativeBlobUtil.cpp: a JSValueArray callback marshals as ONE argument",
      "args": [[true, false]],
      "expected": {"exists": true, "isDirectory": false}
    },
    {
      "platform": "windows",
      "args": [[true, true]],
      "expected": {"exists": true, "isDirectory": true}
    },
    {
      "platform": "windows",
      "args": [[false, false]],
      "expected": {"exists": false, "isDirectory": false}
    }
  ]
}
